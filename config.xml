<?xml version='1.0' encoding='utf-8'?>
<widget id="com.gaga2.tankarena" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Tank Arena</name>
    <description>A Diep.io-style top-down tank shooter with dual virtual joysticks, built for Android via Cordova.</description>
    <author email="jipkhunkaarb@gmail.com" href="https://cordova.apache.org">Tank Arena</author>

    <content src="index.html" />

    <!-- Prototype has no external network calls; keep navigation unrestricted. -->
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />

    <preference name="Fullscreen" value="true" />
    <preference name="DisallowOverscroll" value="true" />
    <preference name="BackgroundColor" value="#FF12141A" />

    <!--
      No <Orientation> preference on purpose: the game's own responsive
      canvas already adapts to both orientations (with a landscape hint
      on narrow portrait phones), so we don't fight that with a native
      orientation lock here.
    -->

    <platform name="android">
        <preference name="android-minSdkVersion" value="24" />
        <preference name="android-targetSdkVersion" value="36" />
        <preference name="AndroidXEnabled" value="true" />
    </platform>
</widget>
